{
	"name": "storyloco",
	"version": "2.13.0",
	"description": "A collection of slick Storyblok field plugins built with Svelte 5, TypeScript, and Tailwind CSS",
	"keywords": [
		"storyblok",
		"field-plugin",
		"svelte",
		"typescript",
		"tailwind",
		"cms",
		"headless"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/darbymanning/storyloco.git"
	},
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"files": [
		"src",
		"packages/mux/types.ts",
		"packages/heading/types.ts",
		"packages/plans/types.ts",
		"packages/link/types.ts",
		"packages/asset/types.ts",
		"packages/asset/r2.ts",
		"packages/theme/types.ts",
		"packages/shared/dist",
		"packages/vite/dist",
		"packages/vite/src/lib/currency.ts",
		"!packages/vite/dist/**/*.test.*",
		"packages/input/types.ts",
		"packages/time/types.ts",
		"packages/seo/types.ts",
		"packages/hubspot_form/types.ts",
		"packages/currency/types.ts",
		"packages/dates/types.ts",
		"packages/churchsuite_categories/types.ts",
		"middleware.js"
	],
	"exports": {
		".": {
			"types": "./packages/vite/dist/storyblok.svelte.d.ts",
			"import": "./packages/vite/dist/storyblok.svelte.js"
		},
		"./mux": {
			"types": "./packages/mux/types.ts"
		},
		"./heading": {
			"types": "./packages/heading/types.ts"
		},
		"./plans": {
			"types": "./packages/plans/types.ts"
		},
		"./input": {
			"types": "./packages/input/types.ts",
			"svelte": "./packages/input/src/app.svelte.ts"
		},
		"./shared": {
			"types": "./packages/shared/dist/index.d.ts",
			"svelte": "./packages/shared/dist/index.js"
		},
		"./link": {
			"types": "./packages/link/types.ts"
		},
		"./asset": {
			"types": "./packages/asset/types.ts"
		},
		"./shared/plugin.css": "./packages/shared/dist/plugin.css",
		"./shared/utils": {
			"types": "./packages/shared/dist/utils.d.ts",
			"svelte": "./packages/shared/dist/utils.js"
		},
		"./vite": {
			"types": "./packages/vite/dist/index.d.ts",
			"import": "./packages/vite/dist/index.js"
		},
		"./hooks": {
			"types": "./packages/vite/dist/hooks.d.ts",
			"import": "./packages/vite/dist/hooks.js"
		},
		"./server": {
			"types": "./packages/vite/dist/server.d.ts",
			"import": "./packages/vite/dist/server.js"
		},
		"./editor": {
			"types": "./packages/vite/dist/editor/index.d.ts",
			"svelte": "./packages/vite/dist/editor/index.js",
			"import": "./packages/vite/dist/editor/index.js"
		},
		"./middleware": {
			"types": "./packages/vite/dist/middleware.d.ts",
			"import": "./packages/vite/dist/middleware.js"
		},
		"./editor/server": {
			"types": "./packages/vite/dist/editor/server.d.ts",
			"import": "./packages/vite/dist/editor/server.js"
		},
		"./time": {
			"types": "./packages/time/types.ts",
			"svelte": "./packages/time/src/app.svelte.ts"
		},
		"./seo": {
			"types": "./packages/seo/types.ts"
		},
		"./hubspot_form": {
			"types": "./packages/hubspot_form/types.ts",
			"svelte": "./packages/hubspot_form/src/app.svelte.ts"
		},
		"./currency": {
			"types": "./packages/currency/types.ts",
			"svelte": "./packages/currency/src/app.svelte.ts"
		},
		"./currency/utils": {
			"types": "./packages/vite/dist/currency.d.ts",
			"import": "./packages/vite/dist/currency.js"
		},
		"./dates": {
			"types": "./packages/dates/types.ts",
			"svelte": "./packages/dates/src/app.svelte.ts"
		},
		"./churchsuite_categories": {
			"types": "./packages/churchsuite_categories/types.ts"
		}
	},
	"devDependencies": {
		"@types/node": "26.6.5",
		"@typescript-eslint/eslint-plugin": "8.72.0",
		"@typescript-eslint/parser": "8.72.0",
		"kitto": "1.16.1",
		"oxfmt": "0.74.0",
		"typescript": "6.0.3",
		"vite": "8.3.5"
	},
	"peerDependencies": {
		"@storyblok/svelte": "7.2.2",
		"@storyblok/field-plugin": "^1.7.1",
		"svelte": "^5.0.0",
		"@sveltejs/kit": "^2.0.0 || ^3.0.0",
		"storyblok-js-client": "^7.0.0"
	},
	"scripts": {
		"add-plugin": "npx @storyblok/field-plugin-cli@latest add --dir \"./packages\" --structure monorepo",
		"build": "cd packages/vite && npm run build && cd ../../packages/shared && npm run build",
		"lint": "oxfmt --check && bun run --filter './packages/*' lint",
		"format": "oxfmt"
	},
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"dependencies": {
		"@tiptap/core": "^3.32.0",
		"@tiptap/extension-blockquote": "^3.32.0",
		"@tiptap/extension-bold": "^3.32.0",
		"@tiptap/extension-code": "^3.32.0",
		"@tiptap/extension-code-block": "^3.32.0",
		"@tiptap/extension-collaboration": "^3.32.0",
		"@tiptap/extension-collaboration-caret": "^3.32.0",
		"@tiptap/extension-document": "^3.32.0",
		"@tiptap/extension-hard-break": "^3.32.0",
		"@tiptap/extension-heading": "^3.32.0",
		"@tiptap/extension-highlight": "^3.32.0",
		"@tiptap/extension-horizontal-rule": "^3.32.0",
		"@tiptap/extension-image": "^3.32.0",
		"@tiptap/extension-italic": "^3.32.0",
		"@tiptap/extension-link": "^3.32.0",
		"@tiptap/extension-list": "^3.32.0",
		"@tiptap/extension-paragraph": "^3.32.0",
		"@tiptap/extension-strike": "^3.32.0",
		"@tiptap/extension-subscript": "^3.32.0",
		"@tiptap/extension-superscript": "^3.32.0",
		"@tiptap/extension-table": "^3.32.0",
		"@tiptap/extension-text": "^3.32.0",
		"@tiptap/extension-underline": "^3.32.0",
		"@tiptap/pm": "^3.32.0",
		"@tiptap/y-tiptap": "^3.0.10",
		"ora": "9.4.1",
		"path-to-regexp": "9.0.0",
		"y-protocols": "^1.0.7",
		"yjs": "^13.6.33"
	}
}
