{
	"name": "uiloco-theme",
	"version": "0.0.0",
	"devDependencies": {
		"@lucide/svelte": "1.61.0",
		"@storyblok/field-plugin": "1.7.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.3",
		"@tsconfig/svelte": "5.0.8",
		"oxfmt": "0.74.0",
		"radashi": "12.9.7",
		"shared": "../shared",
		"svelte": "5.57.2",
		"svelte-check": "4.7.7",
		"typescript": "6.0.3",
		"vite": "8.3.5",
		"vite-plugin-css-injected-by-js": "5.0.2"
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
		"deploy": "bun run build && bunx @storyblok/field-plugin-cli@latest deploy --dotEnvPath '../../.env' --skipPrompts --scope partner-portal",
		"format": "oxfmt"
	},
	"type": "module"
}
